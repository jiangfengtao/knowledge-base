// Knowledge base database schema
// SQLite for local-first, can switch to PostgreSQL for sync server

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  avatar    String?
  // 是否为会员
  isMember   Boolean  @default(false)
  // 会员到期时间（null = 永久）
  memberExpiresAt DateTime?
  // 会员等级：basic / premium / vip
  memberTier String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  knowledgeBases KnowledgeBase[]
  documents      Document[]
  notes          Note[]
  tags           Tag[]
  settings       UserSettings?
  // 用户使用过的邀请码
  usedInviteCodeId String?
  // 社区帖子
  communityPosts     CommunityPost[]
  // 社区回复
  communityReplies   CommunityReply[]
  // 点赞
  communityLikes     CommunityLike[]
  // 通知
  notifications      Notification[]
  // 会员订单
  memberOrders       MemberOrder[]
}

// 邀请码
model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  // 会员天数（0=永久）
  days      Int      @default(365)
  // 会员等级
  tier      String   @default("premium")
  // 是否已使用
  isUsed    Boolean  @default(false)
  // 使用人
  usedBy    String?
  usedAt    DateTime?
  // 创建人（管理员）
  createdBy String
  createdAt DateTime @default(now())
}

// 知识库
model KnowledgeBase {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String?
  // 数字分类编号，如 "00", "01"
  categoryCode String?
  // 父知识库ID，支持层级
  parentId    String?
  parent      KnowledgeBase? @relation("KbChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    KnowledgeBase[] @relation("KbChildren")
  // 排序
  sortOrder   Int      @default(0)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents Document[]

  @@index([userId])
  @@index([parentId])
}

// 文档
model Document {
  id             String   @id @default(cuid())
  title          String
  // 文档内容，HTML 格式（Tiptap 输出）
  content        String   @default("")
  // 纯文本摘要，用于搜索和预览
  plainText      String   @default("")
  // 字数
  wordCount      Int      @default(0)
  knowledgeBaseId String
  knowledgeBase  KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  // 是否收藏
  isFavorite     Boolean  @default(false)
  // 可见性：public（公开）/ members（仅会员）/ private（仅自己）
  visibility     String   @default("private")
  // 是否允许分享（有分享按钮）
  allowShare     Boolean  @default(true)
  // 是否允许复制
  allowCopy      Boolean  @default(true)
  // 版权协议：all-rights / cc-by / cc-by-nc / cc-by-nc-sa
  license        String   @default("all-rights")
  // 是否是系列/专栏（可以包含子文档）
  isSeries       Boolean  @default(false)
  // 系列ID（如果这篇文章属于某个系列）
  seriesId       String?
  // 系列中的排序
  seriesOrder    Int      @default(0)
  // 排序
  sortOrder      Int      @default(0)
  // 同步用：最后修改时间
  lastModifiedAt DateTime @default(now())
  // 同步用：版本号
  version        Int      @default(1)
  // 是否删除（软删除）
  isDeleted      Boolean  @default(false)
  // 阅读量
  viewCount      Int      @default(0)
  // 视频地址（支持 mp4、B站嵌入、YouTube等）
  videoUrl       String?
  // 视频时长（如 "12:30"）
  videoDuration  String?
  // 是否是视频内容
  isVideo        Boolean  @default(false)
  // 视频封面图
  videoThumbnail String?
  // 音频地址（支持 mp3、m4a、wav 等）
  audioUrl       String?
  // 音频时长（如 "05:30"）
  audioDuration  String?
  // 是否是音频内容
  isAudio        Boolean  @default(false)
  // 音频标题（如"第1期：聊聊技术成长"）
  audioTitle     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tags DocumentTag[]
  // 版本历史
  versions DocumentVersion[]
  // 评论
  comments Comment[]

  @@index([knowledgeBaseId])
  @@index([userId, isDeleted])
  @@index([userId, knowledgeBaseId])
  @@index([lastModifiedAt])
  @@index([isDeleted])
  @@index([visibility, isDeleted])
  @@index([isFavorite, userId])
  @@index([seriesId])
}

// 文档版本历史
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String
  content    String
  plainText  String
  wordCount  Int
  version    Int
  // 版本备注
  note       String?
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([documentId, version])
}

// 小记
model Note {
  id         String   @id @default(cuid())
  content    String
  // 纯文本（用于搜索）
  plainText  String   @default("")
  // 小记类型：note（普通小记）/ idea（想法）/ todo（待办）
  type       String   @default("note")
  // 是否收藏
  isFavorite Boolean  @default(false)
  // 是否置顶
  isPinned   Boolean  @default(false)
  // 可见性：public（公开）/ members（仅会员）/ private（仅自己）
  visibility String   @default("private")
  // 是否删除（软删除）
  isDeleted  Boolean  @default(false)
  // 最后修改时间
  lastModifiedAt DateTime @default(now())
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  tags NoteTag[]

  @@index([userId])
  @@index([userId, type])
  @@index([visibility])
  @@index([userId, isDeleted])
}

// 邮件订阅
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  // 是否已确认订阅
  confirmed  Boolean  @default(false)
  // 确认token
  confirmToken String?
  // 订阅来源
  source    String?
  createdAt DateTime @default(now())
  // 最后发送时间
  lastSentAt DateTime?

  @@index([email])
  @@index([confirmed])
}

// 标签
model Tag {
  id       String   @id @default(cuid())
  name     String
  color    String?
  // 父标签ID（支持层级）
  parentId  String?
  parent    Tag?     @relation("TagChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Tag[]    @relation("TagChildren")
  // 排序
  sortOrder Int      @default(0)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  // 标签使用次数
  useCount Int      @default(0)
  createdAt DateTime @default(now())

  documents DocumentTag[]
  notes     NoteTag[]

  @@index([userId])
  @@index([userId, name])
  @@index([parentId])
}

// 文档标签关联
model DocumentTag {
  documentId String
  tagId      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([tagId])
}

// 小记标签关联
model NoteTag {
  noteId String
  tagId  String
  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
}

// 用户设置
model UserSettings {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id])
  // 博客标题
  blogTitle     String?
  // 博客副标题
  blogSubtitle  String?
  // 个人简介
  bio           String?
  // 头像URL
  avatarUrl     String?
  // 社交媒体链接
  socialLinks   String? // JSON 格式存储
  // 默认版权协议
  defaultLicense String  @default("all-rights")
  // 默认是否允许复制
  defaultAllowCopy Boolean @default(true)
  // 默认是否允许分享
  defaultAllowShare Boolean @default(true)
  // AI 配置（JSON 字符串）
  aiConfig       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
}

// 评论
model Comment {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // 评论者昵称
  nickname      String
  // 评论者邮箱（可选，用于回复通知）
  email         String?
  // 评论内容
  content       String
  // 父评论 ID（用于回复）
  parentId      String?
  parent        Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  // 回复的评论
  replies       Comment[] @relation("CommentReplies")
  // 状态：pending / approved / rejected
  status        String   @default("approved")
  // IP 地址（用于防垃圾评论）
  ipAddress     String?
  // 用户代理
  userAgent     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([documentId])
  @@index([documentId, status])
  @@index([parentId])
  @@index([createdAt])
}

// 社区帖子（成员可发帖）
model CommunityPost {
  id          String   @id @default(cuid())
  // 发帖人
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // 发帖人昵称（冗余，方便展示）
  authorName  String
  // 帖子标题
  title       String
  // 帖子内容
  content     String   @default("")
  // 纯文本摘要
  plainText   String   @default("")
  // 帖子类型：discussion（讨论）/ share（分享）/ question（提问）
  type        String   @default("discussion")
  // 分类标签
  category    String?
  // 是否置顶
  isPinned    Boolean  @default(false)
  // 是否精华
  isEssence   Boolean  @default(false)
  // 状态：active / hidden / deleted
  status      String   @default("active")
  // 浏览量
  viewCount   Int      @default(0)
  // 回复数量（冗余计数，避免每次 count）
  replyCount  Int      @default(0)
  // 点赞数量（冗余计数）
  likeCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 回复
  replies     CommunityReply[]
  // 点赞
  likes       CommunityLike[]

  @@index([authorId])
  @@index([status, createdAt])
  @@index([category, status])
  @@index([type, status])
}

// 社区回复
model CommunityReply {
  id          String   @id @default(cuid())
  postId      String
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  // 回复人
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName  String
  // 回复内容
  content     String
  // 父回复 ID（支持楼中楼）
  parentId    String?
  parent      CommunityReply? @relation("ReplyReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     CommunityReply[] @relation("ReplyReplies")
  // 状态
  status      String   @default("active")
  // 点赞数
  likeCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 点赞
  likes       CommunityLike[]

  @@index([postId, status])
  @@index([parentId])
  @@index([authorId])
}

// 点赞（帖子/回复通用）
model CommunityLike {
  id          String   @id @default(cuid())
  // 点赞对象类型：post / reply
  targetType  String
  // 目标 ID（帖子 ID 或回复 ID）
  targetId    String
  // 点赞人
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  // 关联帖子（可选，当 targetType = post 时有值）
  post        CommunityPost? @relation(fields: [targetId], references: [id], onDelete: Cascade, map: "like_post_fk")
  // 关联回复（可选，当 targetType = reply 时有值）
  reply       CommunityReply? @relation(fields: [targetId], references: [id], onDelete: Cascade, map: "like_reply_fk")

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([userId])
}

// 站内通知
model Notification {
  id          String   @id @default(cuid())
  // 接收人
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 通知类型：reply / like / system / membership
  type        String
  // 通知标题
  title       String
  // 通知内容
  content     String
  // 关联链接（点击跳转）
  link        String?
  // 是否已读
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// 会员订单（支付闭环）
model MemberOrder {
  id              String   @id @default(cuid())
  // 订单号（唯一）
  orderNo         String   @unique
  // 用户 ID
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 议价方案 ID
  planId          String
  // 会员等级
  tier            String   @default("premium")
  // 会员天数
  days            Int
  // 金额（分）
  amount          Int
  // 支付方式：wechat / alipay / manual
  paymentMethod   String   @default("manual")
  // 支付状态：pending / paid / cancelled / refunded
  status          String   @default("pending")
  // 微信支付订单号
  transactionId   String?
  // 支付时间
  paidAt          DateTime?
  // 过期时间（订单超时未支付自动关闭）
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([orderNo])
}
